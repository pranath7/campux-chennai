# ==============================================================================
# CAMPUX CHENNAI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# DO NOT COMMIT REAL PRODUCTION SECRETS OR KEYS TO VERSION CONTROL.
# Copy this file to .env.local for local development or enter into Vercel/Netlify dashboard.

# 1. Supabase Cloud Database & Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# 2. Authentication & Session Security (Min 32 characters random string)
SESSION_SECRET=your_super_secret_hmac_sha256_token_signing_key_32chars

# 3. Application Base URL
NEXT_PUBLIC_APP_URL=https://campux-chennai.vercel.app

# 4. Storage Buckets (Pre-configured in supabase_schema.sql)
# notes_vault, payment_proofs, student_ids, avatars
